# Copia este archivo como `.env` (en la misma carpeta que docker-compose.yml)
# y cambia TODAS las contraseñas antes de levantar los contenedores.
#   cp .env.example .env

# --- MariaDB ---
MARIADB_ROOT_PASSWORD=cambia_esta_clave_root
DB_NAME=omeka
DB_USER=omeka
DB_PASSWORD=cambia_esta_clave

# --- Omeka S ---
# La instalación automática solo se ejecuta si estos CUATRO valores están definidos
# y sin comentar (verificado contra entrypoint de la imagen).
OMEKA_ADMIN_EMAIL=admin@example.com
OMEKA_ADMIN_NAME=Administrador
OMEKA_ADMIN_PASSWORD=cambia_esta_clave_admin
OMEKA_SITE_TITLE=Mi Archivo Histórico

# Zona horaria e idioma de la instalación (solo se aplican en la primera instalación)
# Idiomas disponibles según la versión instalada (ej.: es_419 = Español Latinoamérica)
OMEKA_TIMEZONE=America/Santiago
OMEKA_LOCALE=es_419
